# =========================
# Java / Maven
# =========================
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Compiled class files
*.class

# Log files
*.log
logs/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# =========================
# IDE - IntelliJ IDEA
# =========================
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# =========================
# IDE - Eclipse / STS
# =========================
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# =========================
# IDE - VS Code
# =========================
.vscode/
*.code-workspace

# =========================
# IDE - NetBeans
# =========================
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*~

# =========================
# Environment / Secrets
# =========================
# Never commit real credentials or .env files
.env
.env.*
!.env.example
*.env
application-local.properties
application-local.yml
application-secret.properties
application-secret.yml
*.pem
*.key
*.p12
*.jks

# =========================
# Spring Boot
# =========================
# Spring Boot devtools restart trigger
.spring-boot-devtools.properties

# =========================
# Docker
# =========================
# Ignore local docker-compose overrides with secrets
docker-compose.override.yml

# =========================
# Render / Deployment
# =========================
.render/
render.yaml.local

# =========================
# Test / Coverage
# =========================
.surefire-reports/
**/surefire-reports/
**/failsafe-reports/
*.exec
jacoco.exec
coverage/
*.lcov

# =========================
# Maven wrapper (keep it, but ignore its downloaded dists)
# =========================
.mvn/wrapper/maven-wrapper.properties.bak